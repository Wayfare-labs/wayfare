# Build output.
#
# The binary names are anchored to the repo root on purpose: an unanchored
# "wayfared" would also match cmd/wayfared, silently excluding the source
# directory that builds it.
/bin/
/dist/
/wayfare
/wayfared
/ladder
/hop-analysis

# Test and coverage artifacts
*.out
coverage.html

# Logs
*.log

# Browser QA harness dependencies (docs/qa/browser)
/docs/qa/browser/node_modules/

# Editor and OS
.DS_Store

# Claude Code local overrides (personal, not shared)
.claude/settings.local.json
